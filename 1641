    ascendButton.Position = UDim2.new(1, -80, 1, -290)
    ascendButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    ascendButton.BackgroundTransparency = 0.3
    ascendButton.Text = "↑"
    ascendButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    ascendButton.TextSize = 28
    ascendButton.Font = Enum.Font.GothamBold
    ascendButton.Parent = mobileGui

    local ascendCorner = Instance.new("UICorner")
    ascendCorner.CornerRadius = UDim.new(0, 27)
    ascendCorner.Parent = ascendButton

    -- ═══ BOTÓN BAJAR ═══
    descendButton = Instance.new("TextButton")
    descendButton.Name = "DescendBtn"
    descendButton.Size = UDim2.new(0, 55, 0, 55)
    descendButton.Position = UDim2.new(1, -80, 1, -140)
    descendButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    descendButton.BackgroundTransparency = 0.3
    descendButton.Text = "↓"
    descendButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    descendButton.TextSize = 28
    descendButton.Font = Enum.Font.GothamBold
    descendButton.Parent = mobileGui

    local descendCorner = Instance.new("UICorner")
    descendCorner.CornerRadius = UDim.new(0, 27)
    descendCorner.Parent = descendButton

