    toggleButton.MouseButton1Click:Connect(function()
        if not flying then
            startFly()
            toggleButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
            toggleButton.Text = "⬇"
        else
            stopFly()
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            toggleButton.Text = "✈"
        end
    end)

    local ascending = false
    local descending = false

    ascendButton.MouseButton1Down:Connect(function() ascending = true end)
    ascendButton.MouseButton1Up:Connect(function() ascending = false end)
    ascendButton.TouchLongPress:Connect(function() ascending = true end)

    descendButton.MouseButton1Down:Connect(function() descending = true end)
    descendButton.MouseButton1Up:Connect(function() descending = false end)
    descendButton.TouchLongPress:Connect(function() descending = true end)

    -- Guardar refs para el loop de vuelo
    return function()
        local yDir = 0
        if ascending then yDir = yDir + 1 end
        if descending then yDir = yDir - 1 end
        return yDir
    end
end

local getYInput = nil

local function destroyMobileUI()
    if mobileGui then
        mobileGui:Destroy()
        mobileGui = nil
        toggleButton = nil
        ascendButton = nil
        descendButton = nil
    end
    getYInput = nil
end

-- ══════════════════════════════════════════════════
-- INPUT - PC (Teclado)
-- ══════════════════════════════════════════════════
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.W then keys.W = true end
    if input.KeyCode == Enum.KeyCode.A then keys.A = true end
    if input.KeyCode == Enum.KeyCode.S then keys.S = true end
    if input.KeyCode == Enum.KeyCode.D then keys.D = true end
    if input.KeyCode == Enum.KeyCode.Space then keys.Space = true end
    if input.KeyCode == Enum.KeyCode.LeftShift then keys.LeftShift = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then keys.W = false end
    if input.KeyCode == Enum.KeyCode.A then keys.A = false end
    if input.KeyCode == Enum.KeyCode.S then keys.S = false end
    if input.KeyCode == Enum.KeyCode.D then keys.D = false end
    if input.KeyCode == Enum.KeyCode.Space then keys.Space = false end
    if input.KeyCode == Enum.KeyCode.LeftShift then keys.LeftShift = false end
end)

-- ══════════════════════════════════════════════════
-- RESPAWN
-- ══════════════════════════════════════════════════
Player.CharacterAdded:Connect(function(char)
    Character = char
    HumanoidRootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")

    if flying then
        flying = false
        if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        if BodyVelocity then pcall(function() BodyVelocity:Destroy() end) BodyVelocity = nil end
        if BodyGyro then pcall(function() BodyGyro:Destroy() end) BodyGyro = nil end
        disableNoclip()
        destroyMobileUI()

        task.wait(0.8)
        startFly()
    end
    task.wait(0.3)
    hookItems(char)
end)

-- ══════════════════════════════════════════════════
-- NOCLIP SELECTIVO
-- ══════════════════════════════════════════════════
local function enableNoclip()
    if noclipConnection then noclipConnection:Disconnect() end
    noclipConnection = RunService.Stepped:Connect(function()
        pcall(function()
            if HumanoidRootPart and HumanoidRootPart.Parent then
                HumanoidRootPart.CanCollide = false
            end
            local head = Character and Character:FindFirstChild("Head")
            if head then head.CanCollide = false end
        end)
    end)
end

function disableNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

-- ══════════════════════════════════════════════════
-- VUELO CON HUMANIZACIÓN + JOYSTICK NATIVO
-- ══════════════════════════════════════════════════
function startFly()
    Character = Player.Character or Player.CharacterAdded:Wait()
    HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
    Humanoid = Character:WaitForChild("Humanoid")

    savedWS = Humanoid.WalkSpeed
    Humanoid.WalkSpeed = 0
    Humanoid.PlatformStand = true

    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyVelocity.Velocity = Vector3.new(0, 0, 0)
    BodyVelocity.P = 15000
    BodyVelocity.Parent = HumanoidRootPart

    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.D = 200
    BodyGyro.P = 25000
    BodyGyro.Parent = HumanoidRootPart

    enableNoclip()

    -- UI Móvil + obtener función de input vertical
    if isMobile then
        initControlsModule()
        getYInput = createMobileUI()
    end

    -- Humanización
    flyStartTime = tick()
    lastSpeedCalc = tick()
    currentVarSpeed = 0
    nextDipTime = tick() + math.random(DIP_MIN * 10, DIP_MAX * 10) / 10
    dipActive = false
    dipEndTime = 0

    flyConnection = RunService.Heartbeat:Connect(function()
        if not HumanoidRootPart or not HumanoidRootPart.Parent then return end

        local cam = workspace.CurrentCamera
        local camCF = cam.CFrame
        local now = tick()

        -- ═══ SPEED RAMPING ═══
        local elapsed = now - flyStartTime
        local rampFactor = math.min(elapsed / RAMP_TIME, 1)

        -- ═══ SPEED VARIATION ═══
        if now - lastSpeedCalc > 0.3 + math.random() * 0.4 then
            currentVarSpeed = calcVarSpeed()
            lastSpeedCalc = now
        end

        local finalSpeed = currentVarSpeed * rampFactor

        -- ═══ VELOCITY DIPS ═══
        if now >= nextDipTime and not dipActive then
            dipActive = true
            dipEndTime = now + DIP_DUR + math.random() * 0.15
        end

        if dipActive then
            finalSpeed = finalSpeed * DIP_FACTOR
            if now >= dipEndTime then
                dipActive = false
                nextDipTime = now + math.random(DIP_MIN * 10, DIP_MAX * 10) / 10
            end
        end

        -- ═══ DIRECCIÓN ═══
        local direction = Vector3.new(0, 0, 0)

        if isMobile then
            -- JOYSTICK NATIVO: GetMoveVector() devuelve Vector3(X, 0, Z)
            -- X = -1 (izquierda) a 1 (derecha)
            -- Z = -1 (adelante) a 1 (atrás) ← invertido respecto a LookVector
            local moveVec = getJoystickInput()

            if moveVec.Magnitude > 0.05 then
                local camForward = camCF.LookVector
                local camRight = camCF.RightVector
                -- Proyectar solo en plano horizontal
                camForward = Vector3.new(camForward.X, 0, camForward.Z)
                camRight = Vector3.new(camRight.X, 0, camRight.Z)
                if camForward.Magnitude > 0 then camForward = camForward.Unit end
                if camRight.Magnitude > 0 then camRight = camRight.Unit end

                -- moveVec.Z negativo = adelante en el joystick
                direction = direction + (camForward * -moveVec.Z) + (camRight * moveVec.X)
            end

            -- Subir/bajar con botones
            if getYInput then
                local yInput = getYInput()
                if yInput ~= 0 then
                    direction = direction + Vector3.new(0, yInput, 0)
                end
            end
        else
            -- PC: Teclado
            if keys.W then direction = direction + camCF.LookVector end
            if keys.S then direction = direction - camCF.LookVector end
            if keys.A then direction = direction - camCF.RightVector end
            if keys.D then direction = direction + camCF.RightVector end
            if keys.Space then direction = direction + Vector3.new(0, 1, 0) end
            if keys.LeftShift then direction = direction - Vector3.new(0, 1, 0) end
        end

        if direction.Magnitude > 0 then
            direction = jitterVec(direction.Unit)
            BodyVelocity.Velocity = direction * finalSpeed
        else
            BodyVelocity.Velocity = Vector3.new(0, 0.5, 0)
        end

        BodyGyro.CFrame = camCF
    end)

    flying = true
end

local function stopFly()
    flying = false

    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if BodyVelocity then pcall(function() BodyVelocity:Destroy() end) BodyVelocity = nil end
    if BodyGyro then pcall(function() BodyGyro:Destroy() end) BodyGyro = nil end

    disableNoclip()

    if isMobile then
        destroyMobileUI()
    end

    task.defer(function()
        forceResetHumanoid()
    end)
end

-- ══════════════════════════════════════════════════
-- DETECCIÓN DE ITEMS
-- ══════════════════════════════════════════════════
function hookItems(char)
    for _, c in pairs(itemConns) do pcall(function() c:Disconnect() end) end
    itemConns = {}

    local function connectTool(tool)
        if not tool:IsA("Tool") or not isAutoItem(tool.Name) then return end

        table.insert(itemConns, tool.Equipped:Connect(function()
            if not flying then
                startFly()
            end
        end))

        table.insert(itemConns, tool.Unequipped:Connect(function()
            task.wait(0.1)
            if not anyItemEquipped(char) and flying then
                stopFly()
            end
        end))
    end

    for _, child in pairs(char:GetChildren()) do connectTool(child) end
    table.insert(itemConns, char.ChildAdded:Connect(function(child) connectTool(child) end))
    table.insert(itemConns, char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") and isAutoItem(child.Name) and flying then
            task.wait(0.1)
            if not anyItemEquipped(char) then
                stopFly()
            end
        end
    end))
end

if Player.Character then hookItems(Player.Character) end

-- ══════════════════════════════════════════════════
-- TOGGLE PC
-- ══════════════════════════════════════════════════
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.p then
        if not flying then
            startFly()
        else
            stopFly()
        end
    end
end)

