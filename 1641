-- Fly Bypass v8 - MULTIPLATAFORMA + FIX CARPET STUCK
-- Compatible PC + Móvil | Anti-stuck en equip/desequip

local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")

-- ══════════════════════════════════════════════════
-- CONFIG
-- ══════════════════════════════════════════════════
local BASE_SPEED = 210
local SPEED_VAR = 15
local JITTER = 0.05
local DIP_MIN = 3
local DIP_MAX = 8
local DIP_DUR = 0.15
local DIP_FACTOR = 0.3
local RAMP_TIME = 2

local AUTO_ITEMS = {"Flying Carpet", "Flying Bee", "Wave Rider", "Santa's Sleigh", "Cupid's Wings", "Witch's Broom", "Heart Balloon"}

-- ══════════════════════════════════════════════════
-- ESTADO
-- ══════════════════════════════════════════════════
local flying = false
local flySpeed = 0
local flyConnection = nil
local noclipConnection = nil
local BodyVelocity = nil
local BodyGyro = nil
local savedWS = 16

-- Detección de plataforma
local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Teclado (PC)
local keys = {
    W = false, A = false, S = false,
    D = false, Space = false, LeftShift = false
}

-- Touch (Móvil)
local touchMoveVector = Vector3.new(0, 0, 0)
local touchJump = false
local touchDescend = false

-- Estado de humanización
local flyStartTime = 0
local lastSpeedCalc = 0
local currentVarSpeed = BASE_SPEED
local nextDipTime = 0
local dipActive = false
local dipEndTime = 0

local itemConns = {}

-- UI References
local mobileGui = nil
local toggleButton = nil
local ascendButton = nil
local descendButton = nil

-- ══════════════════════════════════════════════════
-- UTILIDADES
-- ══════════════════════════════════════════════════
local function isAutoItem(name)
    for _, n in ipairs(AUTO_ITEMS) do
        if name == n then return true end
    end
    return false
end

local function anyItemEquipped(char)
    for _, child in pairs(char:GetChildren()) do
        if child:IsA("Tool") and isAutoItem(child.Name) then
            return true
        end
    end
    return false
end

local function calcVarSpeed()
    return BASE_SPEED - math.random(0, SPEED_VAR)
end

local function jitterVec(v)
    return Vector3.new(
        v.X + (math.random() - 0.5) * 2 * JITTER,
        v.Y + (math.random() - 0.5) * 2 * JITTER,
        v.Z + (math.random() - 0.5) * 2 * JITTER
    )
end

local function isPlatformStandActive()
    pcall(function()
        if Humanoid then
            return Humanoid:GetState() == Enum.HumanoidStateType.PlatformStanding
        end
    end)
    return false
end

-- ══════════════════════════════════════════════════
-- FIX CARPET STUCK - Restauración completa del humanoid
-- ══════════════════════════════════════════════════
local function forceResetHumanoid()
    pcall(function()
        if not Humanoid or not Humanoid.Parent then return end
        
        -- 1. Quitar PlatformStand
        Humanoid.PlatformStand = false
        Humanoid.Sit = false
        
        -- 2. Restaurar WalkSpeed
        Humanoid.WalkSpeed = savedWS or 16
        
        -- 3. Forzar cambio de estado a GettingUp
        Humanoid:ChangeState(Enum.HumanoidStateType.GetningUp)
        task.wait(0.05)
        Humanoid:ChangeState(Enum.HumanoidStateType.Running)
        
        -- 4. Si sigue atascado, respawnear animaciones
        local animator = Humanoid:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                track:Stop(0)
            end
        end
        
        -- 5. Asegurar que el HRP tiene física correcta
        if HumanoidRootPart and HumanoidRootPart.Parent then
            HumanoidRootPart.CanCollide = true
            HumanoidRootPart.Anchored = false
        end
    end)
end

