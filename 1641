-- ══════════════════════════════════════════════════
-- INPUT - PC (Teclado)
-- ══════════════════════════════════════════════════
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.W then keys.W = true end
    if input.KeyCode == Enum.KeyCode.A then keys.A = true end
    if input.KeyCode == Enum.KeyCode.S then keys.S = true end
    if input.KeyCode == Enum.KeyCode.D then keys.D = true end
    if input.KeyCode == Enum.KeyCode.Space then keys.Space = true end
    if input.KeyCode == Enum.KeyCode.LeftShift then keys.LeftShift = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then keys.W = false end
    if input.KeyCode == Enum.KeyCode.A then keys.A = false end
    if input.KeyCode == Enum.KeyCode.S then keys.S = false end
    if input.KeyCode == Enum.KeyCode.D then keys.D = false end
    if input.KeyCode == Enum.KeyCode.Space then keys.Space = false end
    if input.KeyCode == Enum.KeyCode.LeftShift then keys.LeftShift = false end
end)

-- ══════════════════════════════════════════════════
-- RESPAWN
-- ══════════════════════════════════════════════════
Player.CharacterAdded:Connect(function(char)
    Character = char
    HumanoidRootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
    
    -- Reset completo de estado al respawnear
    if flying then
        flying = false
        if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        if BodyVelocity then pcall(function() BodyVelocity:Destroy() end) BodyVelocity = nil end
        if BodyGyro then pcall(function() BodyGyro:Destroy() end) BodyGyro = nil end
        disableNoclip()
        
        wait(0.8)
        startFly()
    end
    wait(0.3)
    hookItems(char)
end)

-- ══════════════════════════════════════════════════
-- NOCLIP SELECTIVO
-- ══════════════════════════════════════════════════
local function enableNoclip()
    if noclipConnection then noclipConnection:Disconnect() end
    noclipConnection = RunService.Stepped:Connect(function()
        pcall(function()
            if HumanoidRootPart and HumanoidRootPart.Parent then
                HumanoidRootPart.CanCollide = false
            end
            local head = Character and Character:FindFirstChild("Head")
            if head then head.CanCollide = false end
        end)
    end)
end

local function disableNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

-- ══════════════════════════════════════════════════
-- VUELO CON HUMANIZACIÓN + SOPORTE MÓVIL
-- ══════════════════════════════════════════════════
function startFly()
    Character = Player.Character or Player.CharacterAdded:Wait()
    HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
    Humanoid = Character:WaitForChild("Humanoid")

    -- Guardar y modificar
    savedWS = Humanoid.WalkSpeed
    Humanoid.WalkSpeed = 0
    Humanoid.PlatformStand = true

    -- BodyVelocity
    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyVelocity.Velocity = Vector3.new(0, 0, 0)
    BodyVelocity.P = 15000
    BodyVelocity.Parent = HumanoidRootPart

    -- BodyGyro
    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.D = 200
    BodyGyro.P = 25000
    BodyGyro.Parent = HumanoidRootPart

    enableNoclip()

    -- Crear UI móvil si es necesario
    if isMobile then
        createMobileUI()
    end

    -- Inicializar humanización
    flyStartTime = tick()
    lastSpeedCalc = tick()
    currentVarSpeed = 0
    nextDipTime = tick() + math.random(DIP_MIN * 10, DIP_MAX * 10) / 10
    dipActive = false
    dipEndTime = 0

    flyConnection = RunService.Heartbeat:Connect(function()
        if not HumanoidRootPart or not HumanoidRootPart.Parent then return end

        local cam = workspace.CurrentCamera
        local camCF = cam.CFrame
        local now = tick()

        -- ═══ SPEED RAMPING ═══
        local elapsed = now - flyStartTime
        local rampFactor = math.min(elapsed / RAMP_TIME, 1)

        -- ═══ SPEED VARIATION ═══
        if now - lastSpeedCalc > 0.3 + math.random() * 0.4 then
            currentVarSpeed = calcVarSpeed()
            lastSpeedCalc = now
        end

        local finalSpeed = currentVarSpeed * rampFactor

        -- ═══ VELOCITY DIPS ═══
        if now >= nextDipTime and not dipActive then
            dipActive = true
            dipEndTime = now + DIP_DUR + math.random() * 0.15
        end

        if dipActive then
            finalSpeed = finalSpeed * DIP_FACTOR
            if now >= dipEndTime then
                dipActive = false
                nextDipTime = now + math.random(DIP_MIN * 10, DIP_MAX * 10) / 10
            end
        end

        -- ═══ DIRECCIÓN (PC + Móvil) ═══
        local direction = Vector3.new(0, 0, 0)
        
        if isMobile then
            -- Móvil: usar MoveDirection del humanoid + botones ascend/descend
            local moveDir = Humanoid.MoveDirection
            if moveDir.Magnitude > 0 then
                -- Proyectar MoveDirection al plano de la cámara
                local camForward = camCF.LookVector * Vector3.new(1, 0, 1)
                local camRight = camCF.RightVector * Vector3.new(1, 0, 1)
                if camForward.Magnitude > 0 then camForward = camForward.Unit end
                if camRight.Magnitude > 0 then camRight = camRight.Unit end
                
                direction = (camForward * moveDir.Z * -1) + (camRight * moveDir.X)
            end
            if touchJump then
                direction = direction + Vector3.new(0, 1, 0)
            end
            if touchDescend then
                direction = direction - Vector3.new(0, 1, 0)
            end
        else
            -- PC: teclado WASD
            if keys.W then direction = direction + camCF.LookVector end
            if keys.S then direction = direction - camCF.LookVector end
            if keys.A then direction = direction - camCF.RightVector end
            if keys.D then direction = direction + camCF.RightVector end
            if keys.Space then direction = direction + Vector3.new(0, 1, 0) end
            if keys.LeftShift then direction = direction - Vector3.new(0, 1, 0) end
        end

        if direction.Magnitude > 0 then
            direction = jitterVec(direction.Unit)
            BodyVelocity.Velocity = direction * finalSpeed
        else
            -- Mantener posición flotante cuando no hay input
            BodyVelocity.Velocity = Vector3.new(0, 0.5, 0)
        end

        BodyGyro.CFrame = camCF
    end)

    flying = true
end

local function stopFly()
    flying = false

    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if BodyVelocity then pcall(function() BodyVelocity:Destroy() end) BodyVelocity = nil end
    if BodyGyro then pcall(function() BodyGyro:Destroy() end) BodyGyro = nil end
    
    disableNoclip()
    
    -- Destruir UI móvil
    if isMobile then
        destroyMobileUI()
    end
    
    -- FIX CRÍTICO: Restaurar humanoid completamente
    task.defer(function()
        forceResetHumanoid()
    end)
end

-- ══════════════════════════════════════════════════
-- DETECCIÓN DE ITEMS - CON FIX CARPET STUCK
-- ══════════════════════════════════════════════════
function hookItems(char)
    for _, c in pairs(itemConns) do pcall(function() c:Disconnect() end) end
    itemConns = {}

    local function connectTool(tool)
        if not tool:IsA("Tool") or not isAutoItem(tool.Name) then return end

        table.insert(itemConns, tool.Equipped:Connect(function()
            if not flying then
                startFly()
            end
        end))

        table.insert(itemConns, tool.Unequipped:Connect(function()
            -- FIX: Pequeño delay para evitar race condition
            task.wait(0.1)
            if not anyItemEquipped(char) and flying then
                stopFly()
            end
        end))
    end

    for _, child in pairs(char:GetChildren()) do connectTool(child) end
    table.insert(itemConns, char.ChildAdded:Connect(function(child) connectTool(child) end))
    
    -- FIX: Detectar si el tool se destruye mientras está equipado
    table.insert(itemConns, char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") and isAutoItem(child.Name) and flying then
            task.wait(0.1)
            if not anyItemEquipped(char) then
                stopFly()
            end
        end
    end))
end

if Player.Character then hookItems(Player.Character) end

